# Deployment environment (Coolify / Docker Compose).
# Copy to .env for local runs, or set these as environment variables in Coolify.
# Required:
DB_PASSWORD=replace-with-a-strong-password
APP_ORIGIN=https://app.example.com
# Optional first-boot account passwords. If left blank, a random password is
# generated and printed ONCE in the container logs during first bootstrap.
ADMIN_PASSWORD=
ACCOUNTANT_PASSWORD=
CASHIER_PASSWORD=
VIEWER_PASSWORD=